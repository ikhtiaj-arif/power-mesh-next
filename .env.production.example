# =============================================================================
# power-mesh-client — PRODUCTION environment template
# Copy values into your host (Vercel / Netlify / etc.). Do not commit real secrets.
# Pair with power-mesh-server/.env.production.example — origins and ISR token must match.
# =============================================================================

# Express API origin (server-only; used by BFF proxy + ISR/SSR fetches). No trailing slash.
API_URL=https://your-api.example.com

# Same-origin BFF path used by the browser. Keep relative unless you intentionally
# expose Express to the browser (not recommended with ADR-005).
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Public Next.js origin. Must equal FRONTEND_URL on the API (CORS + bKash return).
NEXT_PUBLIC_APP_URL=https://your-app.example.com

# Google Identity Services client id (public). Must match GOOGLE_CLIENT_ID on the API.
# Leave empty to hide Google sign-in on the login page.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# NEVER enable one-click demo login in production.
NEXT_PUBLIC_DEMO_LOGIN=false

# Shared with power-mesh-server ISR_SERVICE_TOKEN.
# Use a long random secret (not the local powermesh-isr-dev-token value).
# Required at build time to prerender /admin|/operator/providers/[id] via generateStaticParams.
ISR_SERVICE_TOKEN=replace_with_a_long_random_isr_token

# Optional cookie name overrides (defaults match the BFF).
# ACCESS_TOKEN_COOKIE_NAME=accessToken
# REFRESH_TOKEN_COOKIE_NAME=refreshToken
