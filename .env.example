API_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_DEMO_LOGIN=false
# Must match ISR_SERVICE_TOKEN on power-mesh-server.
# Needed because /provider/* staff routes are auth-gated (unlike a public
# /doctors catalog). Leave empty only if you skip ISR provider prerender.
ISR_SERVICE_TOKEN=powermesh-isr-dev-token
