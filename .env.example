# Express origin (build-time ISR / generateStaticParams). No trailing slash.
API_URL=http://localhost:5000

# Browser calls Express directly (same pattern as Healthcare-Client).
# Must be an absolute URL — static `out/` has no Next /api proxy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_DEMO_LOGIN=false

# Local shared secret — must match power-mesh-server/.env ISR_SERVICE_TOKEN.
ISR_SERVICE_TOKEN=powermesh-isr-dev-token
