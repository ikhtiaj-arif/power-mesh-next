API_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_DEMO_LOGIN=false
# Local shared secret — must match power-mesh-server/.env ISR_SERVICE_TOKEN.
# For production hosts use .env.production.example (strong random value).
ISR_SERVICE_TOKEN=powermesh-isr-dev-token
